/*
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Long-term cache for immutable/versioned assets
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# JS Modules (safe revalidation due to deep imports)
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
